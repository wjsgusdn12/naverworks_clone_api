# PostgreSQL connection information. Create a local .env file with real values; never commit it.
DB_URL=jdbc:postgresql://localhost:5432/naverworks
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password

# Base64-encoded random 32-byte secret for HS256 JWT signing.
# Example generator (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret
JWT_ISSUER=naverworks-clone-api

# Next.js development origin. Change it when the frontend port changes.
CORS_ALLOWED_ORIGIN=http://localhost:3000
