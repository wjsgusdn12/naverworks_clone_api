flowchart LR
    UA["사용자 A"] --> Nginx["nginx<br/>round-robin · WebSocket upgrade"]
    UB["사용자 B"] --> Nginx
    Nginx --> S1["api-1<br/>A의 세션"]
    Nginx --> S2["api-2<br/>B의 세션"]
